{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // Type checking only: scripts/build.mjs bundles with esbuild, which
    // resolves imports the way a bundler does.
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
