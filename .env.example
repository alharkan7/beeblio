# Optional in a checkout: every value here can be set in the app under
# Settings instead, and a value saved there takes precedence over this file.
# To use the file, copy it to .env.local. Set model IDs to models you have
# deliberately selected; the app does not choose a default model. Keep API
# keys private.

# Required: OpenRouter key for the main research agent and OpenRouter AI helpers.
OPENROUTER_API_KEY=
# Required: OpenRouter model ID for the main agent (provider/model).
OPENROUTER_MODEL_ID=
# Required: context window in tokens for that exact main model, used by Eve for compaction.
OPENROUTER_MODEL_CONTEXT_WINDOW_TOKENS=
# Optional: limit one OpenRouter request in milliseconds. Unset means no time limit.
OPENROUTER_REQUEST_TIMEOUT_MS=
# Optional: OpenRouter model for titles, equations, and sentence suggestions.
# Sentence suggestions and equations use the main model if this is empty.
OPENROUTER_MODEL_ID_LITE=
# Optional: OpenRouter model for document review; uses the main model if empty.
OPENROUTER_MODEL_ID_REVIEW=
# Optional: OpenRouter vision model for image analysis; uses the main model if empty.
OPENROUTER_VISION_MODEL_ID=

# Google Gemini API key for transcription and Knowledge File Search.
GOOGLE_API_KEY=
# Required when using transcription: Gemini transcription model ID.
GOOGLE_TRANSCRIPTION_MODEL_ID=
# Required when creating a Knowledge store: Google embedding model ID (models/...).
# An existing store retains the model it was created with; changing this does not rebuild it.
GOOGLE_KNOWLEDGE_EMBEDDING_MODEL_ID=
# Required when querying Knowledge: Gemini model ID with File Search support.
GOOGLE_KNOWLEDGE_QUERY_MODEL_ID=

# Optional: Monid API key for Monid-backed research tools.
MONID_API_KEY=
# Optional: Brave Search API key for the agent's Brave search tool.
BRAVE_SEARCH_API_KEY=

# Optional: contact email sent to Crossref and used for scholarly metadata requests.
CROSSREF_MAILTO=
# Optional: OpenAlex API key and contact email for literature search.
OPENALEX_API_KEY=
OPENALEX_EMAIL=
# Optional: NCBI API key for PubMed literature search.
NCBI_API_KEY=

# Optional: public HTTPS origin of a tunnel to 127.0.0.1:3000.
# Used for Office Online previews and public share URLs. Microsoft and other
# people cannot reach localhost. Set the tunnel's base URL (no path), keep the
# tunnel running while using these features, and restart pnpm dev if it changes.
PUBLIC_TUNNEL_ORIGIN=
